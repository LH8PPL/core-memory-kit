<?xml version="1.0" encoding="UTF-16"?>
<!--
  CAPTURED FIXTURE — the REAL `cmk-daily-distill` task definition read off the
  maintainer's machine with `schtasks /query /TN cmk-daily-distill /XML ONE`
  on 2026-08-08, BEFORE the Task 265 flag fix. This is the D-424 evidence and
  the D-298 root cause in configuration form.

  REDACTED for the public repo (name-privacy rule): <Author> and <UserId> carry
  the maintainer's account name + SID on the real machine and are replaced with
  placeholders here. Every <Settings> value is verbatim — the settings are the
  whole point of the fixture.

  Note the two ABSENT elements: <RunOnlyIfIdle> (schema default false) and
  <ExecutionTimeLimit>. The task therefore never required an idle state to
  START — the hostile flags are the battery pair plus StopOnIdleEnd.
-->
<Task version="1.3" xmlns="http://schemas.microsoft.com/windows/2004/02/mit/task">
  <RegistrationInfo>
    <Date>2026-07-18T17:39:07</Date>
    <Author>REDACTED-HOST\redacted-user</Author>
    <URI>\cmk-daily-distill</URI>
  </RegistrationInfo>
  <Principals>
    <Principal id="Author">
      <UserId>S-1-5-21-0000000000-0000000000-000000000-1000</UserId>
      <LogonType>InteractiveToken</LogonType>
    </Principal>
  </Principals>
  <Settings>
    <DisallowStartIfOnBatteries>true</DisallowStartIfOnBatteries>
    <StopIfGoingOnBatteries>true</StopIfGoingOnBatteries>
    <MultipleInstancesPolicy>IgnoreNew</MultipleInstancesPolicy>
    <StartWhenAvailable>true</StartWhenAvailable>
    <WakeToRun>true</WakeToRun>
    <IdleSettings>
      <Duration>PT10M</Duration>
      <WaitTimeout>PT1H</WaitTimeout>
      <StopOnIdleEnd>true</StopOnIdleEnd>
      <RestartOnIdle>false</RestartOnIdle>
    </IdleSettings>
    <UseUnifiedSchedulingEngine>true</UseUnifiedSchedulingEngine>
  </Settings>
  <Triggers>
    <CalendarTrigger>
      <StartBoundary>2026-07-18T23:00:00</StartBoundary>
      <ScheduleByDay>
        <DaysInterval>1</DaysInterval>
      </ScheduleByDay>
    </CalendarTrigger>
  </Triggers>
  <Actions Context="Author">
    <Exec>
      <Command>wscript.exe</Command>
      <Arguments>//B //Nologo "C:\proj\context\.locks\cmk-daily-distill-run.vbs"</Arguments>
    </Exec>
  </Actions>
</Task>
